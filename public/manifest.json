{
  "manifest_version": 3,
  "name": "Sim Companies Helper",
  "version": "0.20.4",
  "description": "Various quality of life improvements for Sim Companies players.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.simcompanies.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "contentStyle.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "resources/recipes.json"
      ],
      "matches": [
        "https://www.simcompanies.com/*"
      ]
    }
  ]
}
