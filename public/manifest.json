{
  "manifest_version": 3,
  "name": "Sim Companies Helper",
  "version": "1.0.1",
  "description": "Various quality of life improvements for Sim Companies players.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.simcompanies.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "contentStyle.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
