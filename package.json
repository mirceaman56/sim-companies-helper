{
  "name": "simcompanies-helper",
  "private": true,
  "type": "module",
  "scripts": {
    "build:content": "vite build --mode content",
    "build:background": "vite build --mode background",
    "build": "npm run build:content && npm run build:background",
    "pack": "node scripts/pack-extension.mjs",
    "release:local": "npm run build && npm run pack",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "docs:sync-instructions": "node scripts/sync-copilot-instructions.mjs",
    "docs:check-instructions": "node scripts/sync-copilot-instructions.mjs --check",
    "docs:warn-instructions": "node scripts/precommit-warning.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "check:data-platform": "node scripts/check-data-platform-boundaries.mjs",
    "translate:sync": "node scripts/translate-translations.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "string-similarity-js": "2.1.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "archiver": "7.0.1",
    "eslint": "10.0.2",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "28.0.0",
    "prettier": "3.8.1",
    "vite": "5.4.21",
    "vitest": "4.0.18"
  }
}
