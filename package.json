{
  "name": "simcompanies-helper",
  "private": true,
  "type": "module",
  "scripts": {
    "build:content": "vite build --mode content",
    "build:background": "vite build --mode background",
    "build": "npm run build:content && npm run build:background",
    "pack": "node scripts/pack-extension.mjs",
    "release:local": "npm run build && npm run pack",
    "lint": "eslint src/ tests/ scripts/ eslint.config.js vite.config.js",
    "lint:fix": "eslint src/ tests/ scripts/ eslint.config.js vite.config.js --fix",
    "format": "prettier --write src/ tests/ scripts/",
    "format:check": "prettier --check src/ tests/ scripts/",
    "check": "npm run check:architecture && npm run check:manifest && npm run check:i18n && npm run check:styles && npm run check:markup && npm run check:comments && npm run check:changelog && npm run docs:check-instructions",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:styles": "node scripts/check-styles.mjs",
    "check:markup": "node scripts/check-markup.mjs",
    "check:comments": "node scripts/check-comments.mjs",
    "check:changelog": "node scripts/check-changelog.mjs",
    "verify": "npm run lint && npm run format:check && npm run check && npm test && npm run build",
    "new:feature": "node scripts/new-feature.mjs",
    "docs:sync-instructions": "node scripts/sync-copilot-instructions.mjs",
    "docs:check-instructions": "node scripts/sync-copilot-instructions.mjs --check",
    "docs:warn-instructions": "node scripts/precommit-warning.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "translate:sync": "node scripts/translate-translations.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "string-similarity-js": "2.1.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "archiver": "7.0.1",
    "eslint": "10.0.2",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jsdom": "28.0.0",
    "prettier": "3.8.1",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
